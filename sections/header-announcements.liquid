

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  <div class="announcement-bar__inner">
    <div class="announcement-bar__start">
      {% content_for 'blocks' %}
    </div>

    <div class="announcement-bar__end">
      {% if section.settings.trade_account_text != blank %}
        {% if section.settings.trade_account_link != blank %}
          <a
            class="announcement-bar__trade"
            href="{{ section.settings.trade_account_link }}"
          >
            {{ section.settings.trade_account_text | escape }}
          </a>
        {% else %}
          <span class="announcement-bar__trade">
            {{ section.settings.trade_account_text | escape }}
          </span>
        {% endif %}
      {% endif %}

      {% if section.settings.show_currency %}
        <dropdown-localization-component class="dropdown-localization announcement-bar__currency">
          <button
            type="button"
            class="button dropdown-localization__button localization-selector announcement-bar__currency-button"
            aria-expanded="false"
            aria-controls="announcement-localization-{{ section.id }}"
            ref="button"
            on:click="/toggleSelector"
          >
            <span class="announcement-bar__currency-label">
              {{- localization.country.currency.iso_code }}
              {{ localization.country.currency.symbol -}}
            </span>
            <span class="visually-hidden">
              {{- 'accessibility.localization_region_and_language' | t -}}
            </span>
            <span class="svg-wrapper icon-caret">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>

          <div
            id="announcement-localization-{{ section.id }}"
            class="localization-wrapper right-bound color-custom-popover"
            hidden
            ref="panel"
          >
            {% render 'localization-form',
              show_country: true,
              show_language: false,
              localization_style: 'announcement',
              form_id: section.id
            %}
          </div>
        </dropdown-localization-component>
      {% endif %}
    </div>
  </div>
</aside>

{% stylesheet %}
  .shopify-section:has(.announcement-bar) {
    position: relative;
    z-index: calc(var(--layer-menu-drawer) + 1);
  }

  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    font-size: 0.8125rem;
    line-height: 1.2;
  }

  .announcement-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    width: 100%;

    @media screen and (min-width: 750px) {
      padding-inline: 60px;
    }
  }

  .announcement-bar__start,
  .announcement-bar__end {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .announcement-bar__end {
    margin-inline-start: auto;
    flex-shrink: 0;
  }

  .announcement-bar__item {
    display: inline-flex;
    align-items: center;
    color: var(--announcement-item-color, var(--color-foreground));
  }

  .announcement-bar__item + .announcement-bar__item::before {
    content: "|";
    margin-inline-end: 14px;
    color: rgb(var(--color-foreground-rgb) / 0.35);
  }

  .announcement-bar__item-link,
  .announcement-bar__item-text,
  .announcement-bar__trade {
    color: inherit;
    text-decoration: none;
  }

  .announcement-bar__item-link:hover,
  .announcement-bar__trade:hover {
    text-decoration: underline;
  }

  .announcement-bar__trade {
    color: var(--color-foreground);
  }

  .announcement-bar__currency {
    display: flex;
  }

  .announcement-bar__currency-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    min-height: 0;
    color: var(--color-foreground);
    background: transparent;
    border: 0;
    box-shadow: none;
    font-size: inherit;
    cursor: pointer;
  }

  .announcement-bar__currency-button .svg-wrapper,
  .announcement-bar__currency-button svg {
    width: 12px;
    height: 12px;
  }

  @media screen and (max-width: 749px) {
    .announcement-bar__inner {
      flex-wrap: wrap;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.announcement_links_info"
    },
    {
      "type": "header",
      "content": "t:content.trade_account"
    },
    {
      "type": "text",
      "id": "trade_account_text",
      "label": "t:settings.text",
      "default": "Trade Account"
    },
    {
      "type": "url",
      "id": "trade_account_link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.currency"
    },
    {
      "type": "checkbox",
      "id": "show_currency",
      "label": "t:settings.show_currency",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
